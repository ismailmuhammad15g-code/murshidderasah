
# ====================================
# ملف التكوين - نسخة نموذجية
# ====================================
# قم بنسخ هذا الملف إلى .env وملء القيم الفعلية

# ====================================
# 1. إعدادات البوت الأساسية
# ====================================
# توكن البوت من @BotFather
BOT_TOKEN=

# معلومات المشرف
ADMIN_NAME=
ADMIN_EMAIL=

# ====================================
# 2. إعدادات Webhook/Server (اختياري)
# ====================================
# 🔴 مهم: استبدل yourusername باسم مستخدمك على PythonAnywhere
WEBSITE_URL=https://.com/
WEBHOOK_URL=https://.com/webhook
HOST=0.0.0.0
PORT=8080

# ====================================
# 3. إعدادات البريد الإلكتروني (اختياري)
# ====================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=s
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# ====================================
# 4. إعدادات Telegram API (للسكرابر)
# ====================================
# احصل عليها من: https://my.telegram.org
TELEGRAM_API_ID=25891747
TELEGRAM_API_HASH=56e582709e9cdb87bba1fda163946a66

# ====================================
# 5. إعدادات Google AI (للذكاء الاصطناعي)
# ====================================
# احصل عليها من: https://aistudio.google.com
# 🔥 يمكنك إضافة أكثر من مفتاح لزيادة السرعة (10 مفاتيح = 10 أضعاف أسرع!)
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_API_KEY_5=
GOOGLE_API_KEY_6=
GOOGLE_API_KEY_7=
GOOGLE_API_KEY_8=
GOOGLE_API_KEY_9=
GOOGLE_API_KEY_10=

# ====================================
# 6. إعدادات قاعدة المعرفة (RAG)
# ====================================
# اسم قناة تليجرام المصدر (بدون @)
CHANNEL_USERNAME=

# عدد الأيام للبحث في تاريخ القناة (365 = سنة واحدة)
DAYS_LIMIT=365

# عدد النتائج المشابهة التي سيتم جلبها (زيادة لتحسين الدقة)
TOP_K_RESULTS=15

# نموذج Gemini للإجابات
GEMINI_CHAT_MODEL=gemini-2.0-flash-exp

# نموذج التضمين (Embeddings)
GEMINI_EMBED_MODEL=models/text-embedding-004

# مسار قاعدة البيانات
DB_PATH=./db

# ====================================
# 7. إعدادات Pinecone (Vector Database)
# ====================================
# مفتاح API من Pinecone
PINECONE_API_KEY=

# رابط الاتصال بقاعدة البيانات
PINECONE_HOST=
# ====================================
# 8. إعدادات Google Drive (تخزين الكتب)
# ====================================
# محتوى ملف Service Account JSON (للإنتاج فقط)
# في التطوير، يستخدم ملف murshidderasah-950af6007108.json مباشرة

# ====================================
# 9. إعدادات Flask Web App
# ====================================
FLASK_SECRET_KEY=
UPLOAD_FOLDER=static/uploads
SQLALCHEMY_DATABASE_URI=sqlite:///database.db

# ====================================
# 7. إعدادات V2 - المصادر المتعددة
# ====================================
# رابط أو معرّف جروب الإقامات الخاص (يجب أن يكون حسابك منضماً له)
# مثال: https://t.me/+ABC123xyz أو @groupusername
ACCOMMODATIONS_GROUP_ID=

# ====================================
# 8. إعدادات V2 - الخطة البديلة (البحث في الويب)
# ====================================
# موقع قطاع المعاهد الأزهرية الرسمي (للبحث فيه عند فشل تليجرام)
AZHAR_WEBSITE_URL=
